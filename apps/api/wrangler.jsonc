{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0121e8859874c6fc0d674676e17d9f18",
  "name": "drakar-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "routes": [{ "pattern": "api.drakar.mgcrea.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drakar-licenses",
      // Created 2026-10-29 with `wrangler d1 create drakar-licenses` (WEUR). The id
      // is pinned so a binding can never find some other database by name and
      // slip past the migrations check `make api-deploy` makes.
      "database_id": "91554856-8c79-4489-89fd-e329540fb92f",
      "migrations_dir": "./migrations"
    }
  ],
  // Cloudflare Email Service. Sending to arbitrary recipients needs the Workers
  // Paid plan and a verified sender domain, or send() fails E_SENDER_NOT_VERIFIED.
  // mgcrea.io is already verified in this account for the other apps' Workers.
  "send_email": [{ "name": "EMAIL" }],
  // Per-address limits on the two routes anyone can call. `namespace_id` is any
  // integer unique within the ACCOUNT, not within this Worker, and the numbers
  // mean nothing beyond that. 1001-1002 (bastion and cupertino), 2001-2004
  // (bastion's test environment and canopy) and 3001-4002 (armada) are already
  // held by other Workers on this account (every wrangler.jsonc under
  // ~/Projects, checked 2026-10-28), so this one takes 5001-5002 and its test
  // environment 6001-6002.
  // The limiter is approximate and per-colo, which is the right tool here: it
  // bounds what a stranger can cost in D1 queries and outbound mail, it never
  // gates a customer doing the ordinary thing, and a limited request answers
  // the same way an unlimited one does so nothing is learned from being limited.
  "ratelimits": [
    { "name": "RESEND_LIMIT", "namespace_id": "5001", "simple": { "limit": 5, "period": 60 } },
    { "name": "THANKS_LIMIT", "namespace_id": "5002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "CURRENT_MAJOR": "1",
    // Which deployment this is. Anything but "test" is treated as production,
    // so a missing or misspelt value fails closed rather than open.
    "ENVIRONMENT": "production",
    // The price this Worker is allowed to fulfil, and the whole of the product
    // guard. A new price means changing it here, then `pnpm types` (the
    // generated Env pins this literal) and `make api-deploy`. Emptied, this
    // Worker refuses every sale, because every app on the Stripe account
    // delivers its checkouts to every Worker. See `handleWebhook` in
    // src/index.ts.
    //
    // The live "Drakar" price, created in Phase 4 (2026-10-30); its Payment
    // Link carries it as `price_id`. Until then it was empty, and the Worker
    // refused every checkout (200 and a log line): the trio's sales reach this
    // Worker too, and none of them may leave with a drk1 key.
    "EXPECTED_PRICE_ID": "price_1UWLCYFQJry8F0HMyao4Ohsg",
    "LICENSE_FROM_EMAIL": "licences@mgcrea.io",
    "SITE_URL": "https://drakar.mgcrea.io"
  },
  // Workers Logs. Without it a fulfilment failure leaves no trace on this side
  // at all, and the only forensics is Stripe's own event log.
  "observability": { "enabled": true },
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,

  // The test-mode rehearsal, and the reason it is a named environment rather
  // than a second config file: secrets pushed without `--env` land on the
  // DEFAULT environment, which is the Worker taking real money. A test-mode
  // webhook secret there refuses every genuine payment as an invalid signature.
  //
  // Named environments inherit `main` and `compatibility_date` but NOT bindings
  // or vars, so those are repeated in full below rather than assumed. No custom
  // domain: a rehearsal is reached at its workers.dev URL, and the webhook
  // endpoint is whatever the test-mode Stripe dashboard is pointed at.
  "env": {
    "test": {
      "name": "drakar-api-test",
      // Empty, and it has to be said. Wrangler inherits the top-level `routes`
      // into a named environment, so without it the first `wrangler deploy
      // --env test` takes the api.drakar.mgcrea.io custom domain away from the
      // live Worker, and live webhooks land on the rehearsal, signed for a
      // secret it does not hold. bastion's first test deploy did exactly that
      // on 2026-10-04.
      "routes": [],
      // Created in Phase 2 (2026-10-29) with `wrangler d1 create
      // drakar-licenses-test`, and migrated with `--env test`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "drakar-licenses-test",
          "database_id": "c525e6a9-da4a-41f9-8387-6c372b2402ce",
          "migrations_dir": "./migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "RESEND_LIMIT", "namespace_id": "6001", "simple": { "limit": 5, "period": 60 } },
        { "name": "THANKS_LIMIT", "namespace_id": "6002", "simple": { "limit": 20, "period": 60 } }
      ],
      // The one environment where an empty EXPECTED_PRICE_ID would mean
      // unguarded rather than closed, so it is pinned: the sandbox is shared by
      // every app, and unguarded this Worker would mint real drk1 keys
      // (recorded with livemode = 0, but signed with the production key) for
      // the other apps' test purchases. The test-mode "Drakar" price, created
      // in Phase 4 (2026-10-30); its Payment Link carries it as `price_id`.
      "vars": {
        "CURRENT_MAJOR": "1",
        "ENVIRONMENT": "test",
        "EXPECTED_PRICE_ID": "price_1UWLBbFQJry8F0HMGuwMfNpn",
        "LICENSE_FROM_EMAIL": "licences@mgcrea.io",
        "SITE_URL": "https://drakar.mgcrea.io"
      },
      "observability": { "enabled": true },
      "send_metrics": false,
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
