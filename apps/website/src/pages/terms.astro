---
/**
 * The licence terms, rendered as plain text, as armada, bastion and cupertino render theirs.
 *
 * Read from `apps/apple/EULA` with `?raw`, so the page and the file in the repository
 * cannot disagree: this URL is what the app's Licence pane links as the terms a key is
 * bought under. The text is armada's agreement with the product, its gate and its data
 * changed, and its source section rewritten for the MIT licence Drakar's source is under.
 *
 * `?raw`, not `readFileSync`: Vite resolves this against THIS file at build time and
 * inlines the bytes, where a runtime read would resolve against the bundled chunk in dist/.
 */
import { APP_NAME, REPO_URL, SELLING } from "../config";
import Layout from "../layouts/Layout.astro";

import eula from "../../../apple/EULA?raw";

const lead = "mt-4 mb-0 max-w-[62ch] text-[16px] leading-[1.6] text-pretty text-fg-dim";
const link = "text-accent underline underline-offset-2 hover:text-accent-hi";
---

<Layout
  title={`Licence terms · ${APP_NAME}`}
  description={`The end user licence agreement for the signed, notarized builds of ${APP_NAME}: one payment for every 1.x release on every Mac you own, offline validation, and a 30-day refund.`}
>
  <main id="main" tabindex="-1" class="wrap py-20">
    <div class="mono text-accent">Terms</div>
    <h1
      class="mt-3 mb-0 font-display text-[clamp(28px,4.4vw,40px)] font-semibold tracking-[-0.04em]"
    >
      Licence terms
    </h1>
    {
      !SELLING && (
        <p class={lead}>
          {APP_NAME} is not on sale yet. These are the terms it is planned to be sold under,
          published early so they can be read before anything is sold.
        </p>
      )
    }
    <p class={lead}>
      This covers the signed builds. The source is separate, under
      <a href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener" class={link}>the MIT licence</a>.
    </p>
    <pre
      class="mt-10 mb-0 overflow-x-auto font-mono text-[13px] leading-[1.65] whitespace-pre-wrap text-fg/72">{eula}</pre>
  </main>
</Layout>
