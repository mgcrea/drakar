---
import Conversation from "../components/Conversation.astro";
import Cta from "../components/Cta.astro";
import Editor from "../components/Editor.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import Sessions from "../components/Sessions.astro";
import SiblingApps from "../components/SiblingApps.astro";
import Trust from "../components/Trust.astro";
import Yours from "../components/Yours.astro";
import {
  APP_NAME,
  APP_VERSION,
  DOCS,
  DOWNLOAD,
  MIN_MACOS,
  PRICING,
  SELLING,
  SITE_URL,
  SUPPORT_EMAIL,
  TAGLINE,
} from "../config";
import Layout from "../layouts/Layout.astro";

/** Publisher and site identity. `@id` lets the other schemas point at them. */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: "Magenta Creations",
  url: "https://mg-crea.com",
  email: SUPPORT_EMAIL,
  sameAs: ["https://mg-crea.com", "https://github.com/mgcrea"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: APP_NAME,
  url: SITE_URL,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "en",
};

/**
 * The offer only while SELLING: a price in structured data is a claim the thing
 * can be bought right now.
 */
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: MIN_MACOS,
  softwareRequirements: DOWNLOAD.requires,
  url: SITE_URL,
  description: TAGLINE,
  author: { "@type": "Person", name: "Olivier Louvignes" },
  publisher: { "@id": `${SITE_URL}/#organization` },
  license: DOCS.sourceLicense,
  softwareVersion: APP_VERSION,
  downloadUrl: `${SITE_URL}${DOWNLOAD.zip}`,
  ...(SELLING
    ? {
        offers: {
          "@type": "Offer",
          price: PRICING.amount,
          priceCurrency: PRICING.currency,
          url: `${SITE_URL}${PRICING.buy}`,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

{/*
  The order is the argument: what it looks like, what it runs, what the
  conversation does, the editor, many sessions, what it connects to, and only
  then the price.
*/}
<Layout schema={[organizationSchema, websiteSchema, schema]}>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <Marquee />
    <Yours />
    <Conversation />
    <Editor />
    <Sessions />
    <Trust />
    <Pricing />
    <SiblingApps />
    <Cta />
  </main>
  <Footer />
</Layout>
