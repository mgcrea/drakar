---
/**
 * One release, at a URL worth sharing.
 *
 * This is the page a post links to, so everything a link preview reads is the
 * release's own: the title, the description, and a card with its version and
 * title on it (`pnpm cards`). Releases from before summaries existed fall back to
 * their first headlines and the site card, and still get a page: an old version's
 * notes are what somebody still running it wants to read.
 */
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import ShareRelease from "../../components/ShareRelease.astro";
import { APP_NAME, DOWNLOAD, SITE_URL } from "../../config";
import { RELEASES, type Release } from "../../data/changelog";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return RELEASES.map((release, index) => ({
    params: { version: release.version },
    props: { release, newer: RELEASES[index - 1], older: RELEASES[index + 1] },
  }));
}

interface Props {
  release: Release;
  newer?: Release;
  older?: Release;
}

const { release, newer, older } = Astro.props;
const { summary } = release;

const headline = summary?.title ?? `${APP_NAME} ${release.version}`;
const description =
  summary?.description ??
  (release.highlights.length > 0
    ? `${APP_NAME} ${release.version}: ${release.highlights
        .slice(0, 3)
        // Headlines are written as sentences, but not all of them end like one.
        .map((line) => (/[.!?]$/.test(line) ? line : `${line}.`))
        .join(" ")}`
    : `What changed in ${APP_NAME} ${release.version}, released ${release.longDate}.`);
const url = new URL(release.path, Astro.site).href;
// The release's own card when one was rendered, else the site card, and the alt
// only with it: Layout's default alt describes the site card.
const cardProps = release.card
  ? {
      ogImage: release.card,
      ogImageAlt: `The Drakar icon above “${APP_NAME} ${release.version}”, the line “${headline}”, and the date, ${release.longDate}.`,
    }
  : {};

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${APP_NAME} ${release.version}`,
  url,
  datePublished: release.date,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  publisher: { "@id": `${SITE_URL}/#organization` },
};
---

<Layout
  title={`${APP_NAME} ${release.version} · ${headline}`}
  description={description}
  schema={schema}
  {...cardProps}
>
  <Nav />
  <main id="main" tabindex="-1" class="wrap mx-auto max-w-[72ch] px-6 py-20 md:py-28">
    <a href="/changelog/" class="mono text-accent hover:text-accent-hi">Changelog</a>
    <h1
      class="mt-3 mb-0 font-display text-[clamp(30px,4.4vw,46px)] leading-[1.08] font-semibold tracking-[-0.035em] text-balance"
    >
      {headline}
    </h1>
    <p class="mono mt-4 mb-0 text-fg-muted">
      Version {release.version} · <time datetime={release.date}>{release.longDate}</time>
    </p>
    {
      summary && (
        <p class="mt-6 mb-0 text-[18px] leading-[1.6] text-pretty text-fg-dim">
          {summary.description}
        </p>
      )
    }

    {summary && <ShareRelease post={summary.post} url={url} />}

    {/* The notes are the appcast's HTML, styled from here because renderHTML
        emits bare tags: Drakar's update dialog shows the same markup unstyled. */}
    <div
      class="mt-12 text-[16px] leading-[1.7] text-pretty text-fg-dim
             [&_h3]:mt-12 [&_h3]:mb-4 [&_h3]:font-display [&_h3]:text-[22px] [&_h3]:font-semibold [&_h3]:tracking-[-0.01em] [&_h3]:text-fg
             [&_p]:mt-4 [&_p]:mb-0 [&_li_p:first-child]:mt-0
             [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-5 [&_ul]:pl-5 [&_ul]:marker:text-fg-muted
             [&_strong]:font-medium [&_strong]:text-fg
             [&_code]:font-mono [&_code]:text-[0.92em] [&_code]:break-words [&_code]:text-fg
             [&_a:not([class])]:text-fg [&_a:not([class])]:underline [&_a:not([class])]:decoration-rule-2 [&_a:not([class])]:underline-offset-4"
      set:html={release.html}
    />

    <nav
      class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-6 text-[14px]"
      aria-label="Other releases"
    >
      {
        older ? (
          <a href={older.path} class="text-fg-dim hover:text-fg">
            ← {older.version}
          </a>
        ) : (
          <span />
        )
      }
      <a href="/changelog/" class="text-fg-dim hover:text-fg">All releases</a>
      {
        newer ? (
          <a href={newer.path} class="text-fg-dim hover:text-fg">
            {newer.version} →
          </a>
        ) : (
          /* The newest release, so /download is this very version. Same tab: it
             redirects to a zip; see Button.astro. */
          <a href={DOWNLOAD.zip} class="text-fg-dim hover:text-fg">
            Download {release.version}
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
</Layout>
