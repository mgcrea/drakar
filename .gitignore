.DS_Store
.idea/
.build/
.swiftpm/
DerivedData/
build/
buildServer.json
xcuserdata/
node_modules/
.env
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Cloudflare. The Worker's secrets are staged in apps/api/.<env>.vars before
# scripts/push-worker-secrets.mjs pushes them; their .example templates are tracked,
# the files never are. Globbed rather than listed, armada's and bastion's lesson: a
# list naming .dev.vars and .prod.vars missed .test.vars, which carries the signing
# key too.
.wrangler/
*.vars
!*.vars.example

# Direct distribution. Vendor/ is fetched and checksummed by `make sparkle` rather than
# committed. The rest is key material: the Sparkle private key exported for CI is one
# `git add -A` away from being published with the repository.
Vendor/
sparkle_key.pem
*.pem

# The VS Code extension's UI surface, extracted by scripts/extension-surface.sh: its own
# text, kept on this Mac for `make extension-diff`, never published.
docs/extension-surface/
